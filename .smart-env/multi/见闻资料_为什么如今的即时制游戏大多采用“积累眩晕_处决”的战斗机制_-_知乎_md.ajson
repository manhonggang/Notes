0.01328679,0.01759567,0.21996225,0.01791433,0.06999885,-0.01242882,0.02126853,-0.02764575,0.04610734,0.02260014,-0.05438589,0.00891105,0.09445649,-0.01257069,0.03535311,0.02879849,-0.02710943,0.03623683,-0.02107848,-0.00251039,-0.04413457,0.04688598,-0.06300653,0.02208579,0.14336874,0.01063642,-0.0534319,-0.08486455,-0.00820104,0.00394073,-0.00958809,-0.01059088,0.01486775,0.04514777,-0.04151161,0.05834441,0.00309719,-0.02604412,-0.01553963,0.03669094,0.0093568,0.04137218,0.02560488,0.05862918,0.04023974],"last_embed":{"hash":"1gt06xv","tokens":459}}},"last_read":{"hash":"1gt06xv","at":1753080663659},"class_name":"SmartSource","last_import":{"mtime":1750159190892,"size":56237,"at":1753080620159,"hash":"1gt06xv"},"blocks":{"#---frontmatter---":[1,6],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎":[8,614],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#{1}":[10,55],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）":[56,192],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#{1}":[58,132],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**1、传统BOSS战，只有一次中动机，打完之前都不会有任何激励，使得BOSS设计如果偏难，马上就令游戏体验大幅下降，整个流程单调乏味。**":[133,150],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**1、传统BOSS战，只有一次中动机，打完之前都不会有任何激励，使得BOSS设计如果偏难，马上就令游戏体验大幅下降，整个流程单调乏味。**#{1}":[135,150],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**2、转阶段BOSS战，将中动机切成2-3块。比传统BOSS战好上一些，但是缺乏目标和获得感，仍显乏味。**":[151,158],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**2、转阶段BOSS战，将中动机切成2-3块。比传统BOSS战好上一些，但是缺乏目标和获得感，仍显乏味。**#{1}":[153,158],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**3、部位破坏BOSS战，用跨度较长的短动机覆盖中动机。目标明确，获得感强。**":[159,166],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**3、部位破坏BOSS战，用跨度较长的短动机覆盖中动机。目标明确，获得感强。**#{1}":[161,166],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**4、弱点破坏BOSS战，任意数量与长短的短动机穿插在中动机当中，目标明确，短动机激励效果好。**":[167,178],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**4、弱点破坏BOSS战，任意数量与长短的短动机穿插在中动机当中，目标明确，短动机激励效果好。**#{1}":[169,178],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**5、架势条BOSS战，中动机被分割成若干短动机，玩家自由选择短动机的数量与长短，刺激和激励可以快速转化。**":[179,192],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#一、动机构建（Motivation）#**5、架势条BOSS战，中动机被分割成若干短动机，玩家自由选择短动机的数量与长短，刺激和激励可以快速转化。**#{1}":[181,192],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#二、心流区间（Flow Channel）":[193,240],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#二、心流区间（Flow Channel）#{1}":[195,240],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计":[241,400],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#{1}":[243,288],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#**1、可读性**":[289,334],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#**1、可读性**#{1}":[291,334],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#**2、一致性**":[335,356],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#**2、一致性**#{1}":[337,356],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#**3、均衡性**":[357,400],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#三、BOSS设计#**3、均衡性**#{1}":[359,400],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#四、挑战分层（layers of challenges）":[401,474],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#四、挑战分层（layers of challenges）#{1}":[403,474],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现":[475,610],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#{1}":[477,482],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#1、战斗转折":[483,516],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#1、战斗转折#{1}":[485,516],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#2、角色可信度":[517,584],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#2、角色可信度#{1}":[519,584],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#3、其他":[585,610],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#五、有更好的场景呈现#3、其他#{1}":[587,610],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#尾声":[611,614],"#为什么如今的即时制游戏大多采用“积累眩晕+处决”的战斗机制? - 知乎#尾声#{1}":[613,614]},"outlinks":[{"title":"东方project","target":"https://www.zhihu.com/search?q=%E4%B8%9C%E6%96%B9project&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A2812932432%7D","line":24},{"title":"洛克人